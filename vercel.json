{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/", "dest": "/api/index.php?__page=index" },
    { "src": "/([A-Za-z]+)\\.php", "dest": "/api/index.php?__page=$1" }
  ]
}
