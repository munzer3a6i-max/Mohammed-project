# Copy these into Vercel → Project → Settings → Environment Variables
# (or into a local .env / your shell for `php -S`). Never commit real values.

# Option A: separate values
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_NAME=realestate
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Option B: one connection URL (overrides the values above if set)
# DATABASE_URL=mysql://user:password@host:3306/realestate

# Encrypted connection — required by most cloud MySQL providers (TiDB Cloud, Aiven…)
DB_SSL=true
# Optional: custom CA certificate path (system CA bundle is used by default)
# DB_SSL_CA=/path/to/ca.pem
